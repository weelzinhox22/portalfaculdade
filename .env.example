# Configurações do Supabase
# Copie este arquivo para .env e preencha com suas credenciais reais

# URL do seu projeto Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Chave pública (anon key) do Supabase
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Email Marketing Configuration
REACT_APP_MAILCHIMP_API_KEY=your_mailchimp_api_key_here
REACT_APP_MAILCHIMP_LIST_ID=your_mailchimp_list_id_here
REACT_APP_MAILCHIMP_SERVER=us21

# RD Station (Alternative)
REACT_APP_RD_STATION_TOKEN=your_rd_station_token_here

# Google Analytics
REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# API Base URL
REACT_APP_API_BASE_URL=https://api.fisioestudos.com

# Instruções:
# 1. Acesse https://supabase.com
# 2. Crie um novo projeto
# 3. Vá em Settings > API
# 4. Copie a URL e a anon key
# 5. Cole aqui e renomeie este arquivo para .env
